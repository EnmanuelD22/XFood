# API .NET; debe terminar en /api/v1
XFOOD_API_BASE_URL=https://localhost:7293/api/v1

# Rutas relativas al prefijo /api/v1
NEXT_PUBLIC_XFOOD_MY_LISTINGS_PATH=establishments/{establishmentId}/listings
NEXT_PUBLIC_XFOOD_CATEGORIES_PATH=categories

# Mapa de búsqueda (HU-02). Vacías = teselas de OpenStreetMap con su atribución.
# Confirma el servidor de teselas y su política de uso antes del piloto.
NEXT_PUBLIC_XFOOD_MAP_TILE_URL=
NEXT_PUBLIC_XFOOD_MAP_ATTRIBUTION=
